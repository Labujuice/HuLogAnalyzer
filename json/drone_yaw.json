{
  "id": "drone-euler-yaw",
  "name": "Drone Yaw Angle (deg) [-180, 180]",
  "targetChart": {
    "title": "Yaw Angle",
    "yLabel": "Yaw (deg)",
    "color": "#10b981"
  },
  "operations": [
    {
      "type": "expression",
      "formula": "atan2(2 * (q0 * q3 + q1 * q2), 1 - 2 * (q2 * q2 + q3 * q3)) * 57.2957795",
      "variables": {
        "q0": "vehicle_attitude.q[0]",
        "q1": "vehicle_attitude.q[1]",
        "q2": "vehicle_attitude.q[2]",
        "q3": "vehicle_attitude.q[3]"
      },
      "output": "yaw_deg"
    }
  ]
}
